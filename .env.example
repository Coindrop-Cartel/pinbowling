# PinBowling Environment Configuration
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file to version control.

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pinbowling
DB_USER=your_db_user
DB_PASS=your_db_password

# Security — set strong, unique values for both
API_SECRET=your-strong-api-secret-here
ADMIN_PASSWORD=your-strong-admin-password-here

# CORS Configuration — set allowed origin (e.g. * or https://yourdomain.com)
ALLOWED_ORIGIN=*
